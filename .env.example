# ============================================================
# Postador — variáveis de ambiente
# Copie para .env (chmod 600) e ajuste os valores.
# ============================================================

# --- Manus (https://manus.im -> Settings -> API) ---
MANUS_API_KEY=
MANUS_API_BASE=https://api.manus.ai
# standard | lite | max (lite é mais barato; conta free é forçada para lite)
MANUS_AGENT_PROFILE=standard
MANUS_TIMEOUT=60
MANUS_TENTATIVAS=4

# --- Webhook da Manus ---
# A Manus assina com RSA (chave pública dela) — não existe segredo
# compartilhado. O SECRET aqui é só um pedaço aleatório do caminho, para
# cortar varredura cega. Gere com:  python3 -c "import secrets;print(secrets.token_urlsafe(24))"
MANUS_WEBHOOK_SECRET=
# URL pública COMPLETA que vai ser registrada na Manus (entra na assinatura).
# Ex. com Cloudflare Tunnel: https://postador.seudominio.com/manus/webhook/<SECRET>
# Vazio = sem webhook; o polling a cada MANUTENCAO_MIN minutos captura tudo.
MANUS_WEBHOOK_URL=
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORTA=8787

# --- Fila / entrada ---
# Banco do curador-noturno (lido só para leitura). Vazio = só --jsonl/adicionar.
CURADOR_DB=/home/controlador/curador-noturno/dados/curador.db

# --- Revisão (Telegram) ---
# Pode ser o mesmo bot do curador: o curador só envia, nunca lê updates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# documento (qualidade original, recomendado) | foto (preview maior, comprimida)
TELEGRAM_IMAGEM_COMO=documento
# Segundos do long polling do bot. Baixe se aparecer "quedas seguidas" no log.
TELEGRAM_LONG_POLL=25

# Minutos entre os pollings de segurança do `servir`.
MANUTENCAO_MIN=15

# --- Publicador: humano (Fase 1) | graph_api (Fase 2) ---
PUBLICADOR=humano

# --- Storage opcional (já pensando na Fase 2) ---
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_NAME=

# --- Meta / Graph API — VAZIO na Fase 1, preencher na Fase 2 ---
IG_USER_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
